# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Solo servidor. NUNCA exponer con NEXT_PUBLIC_. Se usa exclusivamente en
# rutas server-side (Route Handlers, Server Actions) para tareas administrativas.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (usada para generar enlaces de reserva, metadatos, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Preparado para fases posteriores (no requerido en el MVP) ---

# WhatsApp Business Platform (Fase 7)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Stripe (Fase 8) — clave secreta y el ID del precio recurrente del plan
# (Dashboard de Stripe → Producto → Precios). El webhook hay que crearlo
# aparte apuntando a https://tu-dominio/api/stripe/webhook, suscrito a
# checkout.session.completed, customer.subscription.updated y
# customer.subscription.deleted — el "signing secret" que da al crearlo
# es STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email transaccional (opcional, notificaciones)
RESEND_API_KEY=
