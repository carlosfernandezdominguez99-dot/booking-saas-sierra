# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Solo servidor. NUNCA exponer con NEXT_PUBLIC_. Se usa exclusivamente en
# rutas server-side (Route Handlers, Server Actions) para tareas administrativas.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (usada para generar enlaces de reserva, metadatos, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Preparado para fases posteriores (no requerido en el MVP) ---

# WhatsApp Business Platform (Fase 7)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Stripe (Fase 8)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Email transaccional (opcional, notificaciones)
RESEND_API_KEY=
